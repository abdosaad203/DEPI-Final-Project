# Copy to docker/.env and adjust for your machine.
POSTGRES_PASSWORD=postgres

# Browser-reachable URLs (host machine — used for OIDC redirects and token issuer)
# Inside containers, apps fetch metadata from http://identity-api:8080 (set in compose).
PUBLIC_IDENTITY_URL=http://localhost:8081
PUBLIC_WEBAPP_URL=http://localhost:5100
PUBLIC_WEBHOOKS_CLIENT_URL=http://localhost:5102
